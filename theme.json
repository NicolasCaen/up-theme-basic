{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "useRootPaddingAwareAlignments": true,
        "custom": {
            "font": {
                "body": "var:preset|font-family|primary",
                "title": "var:preset|font-family|secondary"
            },
            "color": {
                "text": "var:preset|color|contrast",
                "background": "var:preset|color|base"
            },
            "navigation": {
                "footer": "Footer Menu"
            },
            "heading": {
                "margin-y": ".3em"
            },
            "h1": {
                "line-height": "1.15"
            },
            "h2": {
                "line-height": "1"
            },
            "paragraph": {
                "margin-y": "1em",
                "line-height": "1.25"
            },
            "list-item": {
                "margin-y": "1em",
                "line-height": "1.25"
            },
            "quote": {
                "font-weight": "600",
                "line-height": "1.15",
                "text-align": "center",
                "font-style": "italic"
            },
            "button": {
                "padding-y": ".5rem",
                "padding-x": "1rem",
                "radius": "0",
                "width": "2px",
                "style": "solid",
                "font-weight": "600",
                "transition": "all .4s"
            },
            "input": {
                "color-text": "inherit",
                "color-background": "inherit",
                "color-border": "currentColor",
                "color-placeholder": "#999999",
                "color-focus-border": "#C6AA76",
                "padding-y": ".5rem",
                "padding-x": ".75rem",
                "border-radius": "0",
                "border-width": "1px",
                "border-style": "solid",
                "font-size": "1rem",
                "line-height": "1.25",
                "transition": "border-color .2s ease"
            },
            "textarea": {
                "min-height": "120px"
            },
            "submit": {
                "color-text": "currentColor",
                "color-background": "var:preset|color|accent",
                "color-border": "var:preset|color|accent",
                "color-hover-background": "var:preset|color|accent-2",
                "padding-y": ".5rem",
                "padding-x": "1rem",
                "border-radius": "0",
                "border-width": "2px",
                "border-style": "solid",
                "font-size": "var:preset|font-size|s",
                "font-weight": "600",
                "text-transform": "none",
                "transition": "all .4s"
            }
        },
        "appearanceTools": true,
