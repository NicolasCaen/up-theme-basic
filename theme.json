    "styles": {
        "css": "where(.wp-site-blocks) > * { margin-block-start: 0 !important; margin-block-end: 0 !important; }",
           "spacing": {
                "padding": {
                    "top": "0",
                    "right": "var:preset|spacing|16-72",
                    "bottom": "0",
                    "left": "var:preset|spacing|16-72"
                }
            },
            "color": {
                "text": "var:custom|color|text",
                "background": "var:custom|color|background"
            },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--first)"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--second)"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-one)",
                    "lineHeight": "var:custom|typography|h1|line-height"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-three)",
                    "lineHeight": "var:custom|typography|h2|line-height"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-four)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-four)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-five)"
                }
            }
        },
        "blocks": {
            "core/post-content": {
                "spacing": {
                    "blockGap": "0"
                }
            },
            "core/heading":{
                "spacing": {
                    "margin": {
                        "top": "var:custom|spacing|heading|margin-y",
                        "bottom": "var:custom|spacing|heading|margin-y"
                    }
                }
            },
            "core/paragraph": {
                "spacing": {
                    "margin": {
                        "top": "var:custom|spacing|paragraph|margin-y",
                        "bottom": "var:custom|spacing|paragraph|margin-y"
                    }
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--m)",
                    "lineHeight": "var:custom|typography|paragraph|line-height"
                }
            },
            "core/quote": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--h-four)",
                    "fontWeight": "var:custom|typography|quote|font-weight",
                    "lineHeight": "var:custom|typography|quote|line-height",
                    "textAlign": "var:custom|typography|quote|text-align",
                    "fontStyle": "var:custom|typography|quote|font-style"
                },
                "css": "text-wrap:pretty;"
            },
            "core/list-item": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--m)",
                    "lineHeight": "var:custom|typography|list-item|line-height"
                },
                "spacing": {
                    "margin": {
                        "top": "var:custom|spacing|list-item|margin-y",
                        "bottom": "var:custom|spacing|list-item|margin-y"
                    }
                }
            },
            "core/button": {
                "css": "transition:var(--wp--custom--transition--button)",
                "border": {
                    "radius": "var:custom|border|button|radius",
                    "color": "var(--wp--preset--color--accent)",
                    "width": "var:custom|border|button|width",
                    "style": "var:custom|border|button|style"
                },
                "color": {
                    "text": "currentColor",
                    "background": "var(--wp--preset--color--accent)"
                },
                "typography": {
                    "textTransform": "none",
                    "fontSize": "var(--wp--preset--font-size--s)",
                    "fontWeight": "var:custom|typography|button|font-weight"
                },
                "spacing": {
                    "padding": {
                        "bottom": "var:custom|spacing|button|padding-y",
                        "left": "var:custom|spacing|button|padding-x",
                        "right": "var:custom|spacing|button|padding-x",
                        "top": "var:custom|spacing|button|padding-y"
                    }
                },
                "variations": {
                    "outline": {
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--accent)"
                        },
                        "border": {
                            "color": "currentColor"
                        },
                        "typography": {
                            "textTransform": "none",
                            "fontSize": "var(--wp--preset--font-size--s)",
                            "fontWeight": "var:custom|typography|button|font-weight"
                        }
                    }
                }
            }
        }
    },
