{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
         "useRootPaddingAwareAlignments": true,
        "custom": {
            "navigation": {
                "footer": "Footer Menu"
            },
            "color": {
                "text": "var:preset|color|base2",
                "background": "var:preset|color|base"
            },
            "spacing": {
                "heading": {
                    "margin-y": ".3em"
                },
                "paragraph": {
                    "margin-y": "1em"
                },
                "list-item": {
                    "margin-y": "1em"
                },
                "button": {
                    "padding-y": ".5rem",
                    "padding-x": "1rem"
                }
            },
            "border": {
                "button": {
                    "radius": "0",
                    "width": "2px",
                    "style": "solid"
                }
            },
            "typography": {
                "h1": {
                    "line-height": "1.15"
                },
                "h2": {
                    "line-height": "1"
                },
                "paragraph": {
                    "line-height": "1.25"
                },
                "list-item": {
                    "line-height": "1.25"
                },
                "quote": {
                    "font-weight": "600",
                    "line-height": "1.15",
                    "text-align": "center",
                    "font-style": "italic"
                },
                "button": {
                    "font-weight": "600"
                }
            },
            "transition": {
                "button": "all .4s"
            },
            "form": {
                "input": {
                    "color": {
                        "text": "inherit",
                        "background": "inherit",
                        "border":   "currentColor",
                        "placeholder": "#999999",
                        "focus-border": "#C6AA76"
                    },
                    "spacing": {
                        "padding-y": ".5rem",
                        "padding-x": ".75rem"
                    },
                    "border": {
                        "radius": "0",
                        "width": "1px",
                        "style": "solid"
                    },
                    "typography": {
                        "font-size": "1rem",
                        "line-height": "1.25"
                    },
                    "transition": "border-color .2s ease"
                },
                "textarea": {
                    "spacing": {
                        "min-height": "120px"
                    }
                },
                "submit": {
                    "color": {
                        "text": "currentColor",
                        "background": "var(--wp--preset--color--accent)",
                        "border": "var(--wp--preset--color--accent)",
                        "hover-background": "var(--wp--preset--color--accent-2)"
                    },
                    "spacing": {
                        "padding-y": ".5rem",
                        "padding-x": "1rem"
                    },
                    "border": {
                        "radius": "0",
                        "width": "2px",
                        "style": "solid"
                    },
                    "typography": {
                        "font-size": "var(--wp--preset--font-size--s)",
                        "font-weight": "600",
                        "text-transform": "none"
                    },
                    "transition": "all .4s"
                }
            }
        },
       
        "appearanceTools": true,
        "shadow": {
            "defaultPresets": false,
            "presets": [
                {
                    "name": "Crisp",
                    "slug": "crisp",
                    "shadow": "6px 6px 0px 0px var(--wp--preset--color--accent)"
                },
                {
                    "name": "Outlined",
                    "slug": "outlined",
                    "shadow": "0px 4px 40px 0px rgba(0, 0, 0, 0.20)"
                },
                {
                    "name": "Outlined 2",
                    "slug": "outlined 2",
                    "shadow": "0px 2px 10px 0px rgba(31, 69, 96, 0.25)"
                }
            ]
        },
        "layout": {
            "contentSize": "820px",
            "wideSize": "1400px"
        },
        "border": {
