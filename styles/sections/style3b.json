{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "slug": "style3b",
    "title": "style3 b",
    "blockTypes": [
        "core/group",
        "core/columns",
        "core/column",
        "core/cover"
    ],
    "styles": {
        "css":"--inner-border-color: grey",
        "color": {
            "background": "var:custom|style|3|background",
            "text": "var:preset|color|primary-light"
        },
        "blocks": {
            "core/button": {
                "color": {
                    "background": "var:custom|style|3|button|background",
                    "text": "var:custom|style|3|button|text"
                },
                "border": {
                    "color": "var:custom|style|3|button|border-color",
                    "width": "1px",
                    "radius": "40"
                },
                ":hover": {
                    "color": {
                        "background": "var:custom|style|3|button|hover-background",
                        "text": "var:custom|style|3|button|hover-text"
                    },
                    "border": {
                        "color": "var:custom|style|3|button|hover-border"
                    }
                }
            }
        },
        "elements": {
            "button": {
                ":hover": {
                    "color": {
                        "background": "var:custom|style|3|button|hover-background !important",
                        "text": "var:custom|style|3|button|hover-text !important"
                    },
                    "border": {
                        "color": "var:custom|style|3|button|hover-border !important"
                    }
                }
            },
            "heading": {
                "color": {
                    "text": "var:custom|style|3|heading|text"
                }
            },
            "link": {
                "color": {
                    "text": "var:custom|style|3|link|text"
                },
                ":hover": {
                    "color": {
                        "text": "var:custom|style|3|link|hover-text"
                    }
                },
                "typography": {
                    "textDecoration": "none"
                }
            }
        }
    }
}
