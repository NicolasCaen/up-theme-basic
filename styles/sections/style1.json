{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "slug": "style1",
    "title": "style1",
    "blockTypes": [
        "core/group",
        "core/columns",
        "core/column",
        "core/cover"
    ],
    "styles": {
        "color": {
            "background": "var:preset|color|base",
            "text": "var:preset|color|contrast"
        },
        "blocks": {
            "core/button":{
                "color": {
                    "background": "var:preset|color|base",
                    "text": "var:preset|color|contrast-2"
                },
                "border": {
                    "color": "var:preset|color|contrast-3",
                    "width": "1px",
                    "radius": "40"
                }
            }
        }
    }
}